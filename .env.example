HTTP_ADDR=:8080
APP_TIMEZONE=Asia/Shanghai
# 程序详细日志。默认关闭，不控制 SQL。
APP_DEBUG=false
# SQL 日志级别，和 APP_DEBUG 分开。可选 silent、error、warn、info。
SQL_LOG_LEVEL=silent

# 开发阶段保持 false。发布或手动升级时改为 true，走 GORM AutoMigrate。
DB_AUTO_MIGRATE=true

# 使用项目目录里的 sqlite 副本。
DB_DATABASE=database/database.sqlite
# 媒体根目录，对应原来的 storage/app，对外路径仍是 /storage/...
DATA_DIR=storage/app
# 为空时用 DATA_DIR/public/medias。目录必须已经存在，任务不会创建它。
HUMAN_READABLE_DIR=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

BILIBILI_FAV_VIDEOS_PAGE_SIZE=40
BILIBILI_DOWNLOAD_CONCURRENCY=3
BILIBILI_LIMIT_DOWNLOAD_VIDEO_JOB=2
BILIBILI_IGNORE_COOKIES=false
BILIBILI_SETTING_READ_ONLY=false
